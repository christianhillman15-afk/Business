# Copy to .env and fill in. All values have sensible dev defaults.

# --- AI ---------------------------------------------------------------------
# Without a key the app runs with deterministic offline AI stubs.
ANTHROPIC_API_KEY=
# Model used for drafting + support. claude-opus-4-8 is the default.
LEADPILOT_AI_MODEL=claude-opus-4-8
# Cheaper model used for high-volume lead relevance classification.
LEADPILOT_AI_CLASSIFIER_MODEL=claude-haiku-4-5

# --- Backend ----------------------------------------------------------------
# SQLite by default; switch to postgresql+psycopg://user:pass@host/db for prod.
DATABASE_URL=sqlite:///./leadpilot.db
# CHANGE THIS in production. Used to sign JWTs.
SECRET_KEY=dev-insecure-change-me
# 256-bit key material for AES-256 encryption of connected sessions at rest.
# Defaults to SECRET_KEY if unset; set a separate value in production.
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# --- Connectors & safety ----------------------------------------------------
# When false (default), real connectors NEVER publish and discovery uses the
# offline sample source — connected accounts stay safe. See docs/COMPLIANCE.md.
LEADPILOT_LIVE_CONNECTORS=false
# Comma-separated Meta Group/Page IDs the connected account is authorized to read.
META_GROUP_IDS=

# --- Scheduler (background discovery) ---------------------------------------
LEADPILOT_SCHEDULER_ENABLED=false
LEADPILOT_SCHEDULER_INTERVAL_MINUTES=30

# --- Billing (Stripe) -------------------------------------------------------
# Leave blank to use the built-in mock billing provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: map plans to Stripe price IDs, e.g. "starter:price_abc,growth:price_def"
STRIPE_PRICES=

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
