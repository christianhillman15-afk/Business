# Copy to .env and fill in. All values have sensible dev defaults.

# --- AI ---------------------------------------------------------------------
# Without a key the app runs with deterministic offline AI stubs.
ANTHROPIC_API_KEY=
# Model used for drafting + support. claude-opus-4-8 is the default.
LEADPILOT_AI_MODEL=claude-opus-4-8
# Cheaper model used for high-volume lead relevance classification.
LEADPILOT_AI_CLASSIFIER_MODEL=claude-haiku-4-5

# --- Backend ----------------------------------------------------------------
# SQLite by default; switch to postgresql+psycopg://user:pass@host/db for prod.
DATABASE_URL=sqlite:///./leadpilot.db
# CHANGE THIS in production. Used to sign JWTs.
SECRET_KEY=dev-insecure-change-me
# 256-bit key material for AES-256 encryption of connected sessions at rest.
# Defaults to SECRET_KEY if unset; set a separate value in production.
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# --- Connectors & safety ----------------------------------------------------
# When false (default), real connectors NEVER publish and discovery uses the
# offline sample source — connected accounts stay safe. See docs/COMPLIANCE.md.
LEADPILOT_LIVE_CONNECTORS=false
# Comma-separated Meta Group/Page IDs the connected account is authorized to read.
META_GROUP_IDS=

# --- Scheduler (background discovery + scheduled Business Posts) -------------
LEADPILOT_SCHEDULER_ENABLED=false
LEADPILOT_SCHEDULER_INTERVAL_MINUTES=30
# Min hours between Business Posts per platform (Nextdoor limits frequency).
BROADCAST_MIN_INTERVAL_HOURS=20

# --- Email (transactional) --------------------------------------------------
# "console" logs emails (default). "smtp" sends real email.
EMAIL_BACKEND=console
EMAIL_FROM=LeadPilot <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
#
# Zoho — recommended: ZeptoMail (Zoho's transactional email service):
#   EMAIL_BACKEND=smtp
#   SMTP_HOST=smtp.zeptomail.com      # .eu / .in for those regions
#   SMTP_PORT=587
#   SMTP_USER=emailapikey             # literally the word "emailapikey"
#   SMTP_PASSWORD=<your ZeptoMail "Send Mail" token>
#   SMTP_USE_TLS=true
#   EMAIL_FROM=LeadPilot <no-reply@yourdomain.com>   # domain verified in ZeptoMail
#
# Or plain Zoho Mail SMTP (fine for low volume / your support@ inbox):
#   SMTP_HOST=smtp.zoho.com           # .eu / .in for those regions
#   SMTP_PORT=587
#   SMTP_USER=no-reply@yourdomain.com
#   SMTP_PASSWORD=<account or app-specific password if 2FA is on>
#   SMTP_USE_TLS=true

# --- OAuth (official, no-password account connection) -----------------------
# Public base URL of the backend, used to build OAuth redirect URIs.
OAUTH_REDIRECT_BASE=http://localhost:8000
# Set these once your Meta / Nextdoor developer apps are approved. Until then,
# the connect flow uses a simulated dev path (no real authorization).
META_CLIENT_ID=
META_CLIENT_SECRET=
NEXTDOOR_CLIENT_ID=
NEXTDOOR_CLIENT_SECRET=

# --- Billing (Stripe) -------------------------------------------------------
# Leave blank to use the built-in mock billing provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: map plans to Stripe price IDs, e.g. "starter:price_abc,growth:price_def"
STRIPE_PRICES=

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
