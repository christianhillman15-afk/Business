# Copy to `.env` and fill in. NEVER commit your real .env.
# These are only needed for the OPTIONAL features that use them.

# --- Notifications (optional) ---
# Discord/Slack incoming webhook URL for alerts.
WHALEBOT_WEBHOOK_URL=
# Telegram bot token (set chat_id in config.yaml).
TELEGRAM_BOT_TOKEN=

# --- Live following (optional, only if follow.enabled + dry_run=false) ---
# Private key of the Polygon wallet that holds your USDC. KEEP THIS SECRET.
POLYMARKET_PRIVATE_KEY=
# Polymarket proxy/funder address (the address shown in your Polymarket profile).
# Leave blank if signing directly with an EOA.
POLYMARKET_FUNDER=
